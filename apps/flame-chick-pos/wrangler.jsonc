{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flamechickpos",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-27",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/qz/sign"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "persist": true, "invocation_logs": true },
    "traces": { "enabled": false, "persist": false, "head_sampling_rate": 0.1 }
  }
}
